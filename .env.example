# Copy this file to .env and fill in your own values.
# Never commit .env or real credentials.

# HTTP server
PORT=5000
NODE_ENV=development

# MongoDB: use a local mongod or a MongoDB Atlas connection string
DB_URI=mongodb://127.0.0.1:27017/the-book-heaven

# Clerk application keys (Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Comma-separated browser origins allowed to call the API.
# Leave empty to allow any origin (fine for local development, not recommended
# for production).
CORS_ORIGIN=http://localhost:3000
