    "url": "https://github.com/zakriayousafzai/the-book-heaven-backend/issues"
  },
  "homepage": "https://github.com/zakriayousafzai/the-book-heaven-backend#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clerk/express": "^2.1.83",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.7",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
